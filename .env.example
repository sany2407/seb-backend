PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase — from https://supabase.com/dashboard/project/_/settings/api-keys
# Use the `sb_secret_*` Secret key (legacy `service_role` key also works).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # legacy alternative to SUPABASE_SECRET_KEY

# Cloudinary — from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
